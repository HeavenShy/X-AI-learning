{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "description": "AI 闯关学习小程序前端",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "Sass",
    "framework": "React"
  },
  "scripts": {
    "prepare": "husky",
    "new": "taro new",
    "build:weapp": "taro build --type weapp",
    "dev:weapp": "npm run build:weapp -- --watch",
    "build:h5": "taro build --type h5",
    "dev:h5": "npm run build:h5 -- --watch",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --skipLibCheck -p .",
    "gen:icons": "tsx scripts/gen-icon-styles.ts"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "author": "",
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.2",
    "@tarojs/helper": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.3.2",
    "@tarojs/plugin-generator": "4.3.2",
    "@tarojs/taro-loader": "4.3.2",
    "@tarojs/webpack5-runner": "4.3.2",
    "@types/minimatch": "^5",
    "@types/node": "^18",
    "@types/react": "^18.0.0",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.3.2",
    "eslint": "^8.57.0",
    "eslint-config-taro": "4.3.2",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "sass": "^1.75.0",
    "stylelint": "^16.4.0",
    "stylelint-config-standard": "^38.0.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.4.5",
    "webpack": "5.91.0"
  }
}
