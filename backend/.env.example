# 复制为 .env 后填写
APP_ENV=dev
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 结构化输出依赖命名 tool_choice，思考模式不支持，保持 disabled
DEEPSEEK_THINKING=disabled
LLM_TIMEOUT_SECONDS=60
CORS_ORIGINS=["https://servicewechat.com","http://localhost:10086"]

# 出题前联网检索（Tavily Search，https://app.tavily.com 申请 Key）。留空则不检索，按原流程出题。
# 每次出题消耗 1 credit（basic），免费额度 1000 次/月；失败 / 超时 / 额度用尽时自动降级为不检索
TAVILY_API_KEY=

# MySQL（Docker：见 README「数据库」）。MYSQL_DATABASE 留空则不连库，接口按匿名模式工作
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=yhyd
MYSQL_PASSWORD=yhyd_dev_2026
MYSQL_DATABASE=yhyd

# 微信小程序登录。APP_ENV=dev 且 WECHAT_APP_SECRET 为空时启用模拟登录（固定开发用户）
WECHAT_APP_ID=wx036b4607377f970d
WECHAT_APP_SECRET=

# JWT 签名密钥，生产环境必须配置（python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=
JWT_EXPIRE_DAYS=30
