# 复制为 .env 后填写
APP_ENV=dev
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 结构化输出依赖命名 tool_choice，思考模式不支持，保持 disabled
DEEPSEEK_THINKING=disabled
LLM_TIMEOUT_SECONDS=60
CORS_ORIGINS=["https://servicewechat.com","http://localhost:10086"]

# 出题前联网检索（Tavily Search，https://app.tavily.com 申请 Key）。留空则不检索，按原流程出题。
# 每次出题消耗 1 credit（basic），免费额度 1000 次/月；失败 / 超时 / 额度用尽时自动降级为不检索
TAVILY_API_KEY=

# 知识库（RAG）：硅基流动 Embedding（BAAI/bge-m3，https://cloud.siliconflow.cn 申请 Key）。留空则知识库功能关闭。
# 注意：上传的资料文本会发送给硅基流动做向量化；向量库为嵌入式 Chroma（data/chroma），后端只能单 worker 运行
SILICONFLOW_API_KEY=

# 出题前的检索规划 Agent：由模型决定查知识库、联网、都查还是都不查（每次出题多 1–3 次短的 DeepSeek 调用）。
# 设为 false 回到固定规则：首页出题固定联网一次、不查知识库；知识库出题不联网
AGENT_RETRIEVAL_ENABLED=true
# 知识库出题时是否允许 Agent 联网查背景资料（只作背景，不作出题依据）。
# 联网查询词由 Agent 写，Prompt 要求不含资料原文但无法完全保证；资料需要严格保密时设为 false
AGENT_WEB_IN_KB_QUIZ=true

# 网页出题：后端直接抓取用户给的网址（只允许公网 http/https、端口 80/443），读不出正文时用 Tavily Extract 兜底
# （需要 TAVILY_API_KEY，兜底时网址会发给 Tavily）。设为 false 关闭网页出题，网页接口返回 5000
WEB_FETCH_ENABLED=true
WEB_EXTRACT_TAVILY_FALLBACK=true

# 视频出题：上传视频或 B 站链接 → ffmpeg 抽音轨 → 硅基流动语音转写（用上面的 SILICONFLOW_API_KEY，没配则关闭）。
# 音频会发送给硅基流动转写；上传的视频处理完即删除。B 站链接尽力而为（风控 / 登录 / 版权限制时读不了）
VIDEO_ENABLED=true
BILIBILI_ENABLED=true

# MySQL（Docker：见 README「数据库」）。MYSQL_DATABASE 留空则不连库，接口按匿名模式工作
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=yhyd
MYSQL_PASSWORD=yhyd_dev_2026
MYSQL_DATABASE=yhyd

# 微信小程序登录。APP_ENV=dev 且 WECHAT_APP_SECRET 为空时启用模拟登录（固定开发用户）
WECHAT_APP_ID=wx036b4607377f970d
WECHAT_APP_SECRET=

# JWT 签名密钥，生产环境必须配置（python -c "import secrets;print(secrets.token_urlsafe(48))"）
JWT_SECRET=
JWT_EXPIRE_DAYS=30
